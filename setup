#!/usr/bin/env bash
set -e

VENV_DIR=".venv"

PYTHON=""
for candidate in python3.12 python3.11 python3.10 python3.9 python3; do
    if command -v "$candidate" >/dev/null 2>&1 && \
       "$candidate" -c "import sys; exit(0 if sys.version_info >= (3, 9) else 1)" 2>/dev/null; then
        PYTHON="$candidate"
        break
    fi
done
if [ -z "$PYTHON" ]; then
    echo "Требуется Python версии 3.9 или новее." >&2
    exit 1
fi

# Используем uv, если он доступен (в 10-100 раз быстрее), иначе — pip.
UV_INSTALL="pip install"
UV_VENV="$PYTHON -m venv"
if command -v uv >/dev/null 2>&1; then
    echo "  обнаружен uv — использую uv для управления пакетами"
    UV_INSTALL="uv pip install"
    UV_VENV="uv venv"
fi

[ -d "$VENV_DIR" ] || $UV_VENV "$VENV_DIR"
source "$VENV_DIR/bin/activate"

if [ "$UV_INSTALL" = "pip install" ]; then
    pip install --upgrade pip -q
fi
$UV_INSTALL -e ".[train]" -q

if command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi >/dev/null 2>&1; then
    echo "Обнаружен NVIDIA GPU; устанавливаю дополнительные пакеты gpu..."
    $UV_INSTALL -e ".[gpu]" -q
fi

needle --help
